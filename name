<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Tienda Atletismo</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }

    header {
      background-color: #1a73e8;
      color: white;
      padding: 20px;
      text-align: center;
    }

    nav {
      background-color: #004aad;
      display: flex;
      justify-content: center;
      gap: 30px;
      padding: 10px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    nav a:hover {
      text-decoration: underline;
    }

    section {
      padding: 40px;
      max-width: 1000px;
      margin: auto;
    }

    h2 {
      color: #004aad;
      text-align: center;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .product {
      background-color: white;
      padding: 15px;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      text-align: center;
    }

    .product img {
      width: 100%;
      border-radius: 10px;
    }

    .price {
      color: green;
      font-weight: bold;
      margin: 10px 0;
    }

    button {
      background-color: #1a73e8;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 5px;
      cursor: pointer;
    }

    button:hover {
      background-color: #004aad;
    }

    footer {
      background-color: #1a73e8;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 40px;
    }
  </style>
</head>
<body>

  <header>
    <h1>Tienda de Atletismo</h1>
    <p>Todo lo que necesitás para correr, saltar y superarte</p>
  </header>

  <nav>
    <a href="#calzado">Calzado</a>
    <a href="#ropa">Ropa</a>
    <a href="#accesorios">Accesorios</a>
  </nav>

  <section id="calzado">
    <h2>Calzado</h2>
    <div class="products">
      <div class="product">
        <img src="https://via.placeholder.com/220x150?text=Zapatillas+Running">
        <h3>Zapatillas Running Nike</h3>
        <p class="price">$25.000</p>
        <button>Agregar al carrito</button>
      </div>
      <div class="product">
        <img src="https://via.placeholder.com/220x150?text=Clavos+de+Atletismo">
        <h3>Clavos de velocidad Puma</h3>
        <p class="price">$32.500</p>
        <button>Agregar al carrito</button>
      </div>
    </div>
  </section>

  <section id="ropa">
    <h2>Ropa Deportiva</h2>
    <div class="products">
      <div class="product">
        <img src="https://via.placeholder.com/220x150?text=Shorts">
        <h3>Shorts livianos Adidas</h3>
        <p class="price">$9.900</p>
        <button>Agregar al carrito</button>
      </div>
      <div class="product">
        <img src="https://via.placeholder.com/220x150?text=Remera">
        <h3>Remera técnica Mizuno</h3>
        <p class="price">$12.400</p>
        <button>Agregar al carrito</button>
      </div>
    </div>
  </section>

  <section id="accesorios">
    <h2>Accesorios</h2>
    <div class="products">
      <div class="product">
        <img src="https://via.placeholder.com/220x150?text=Cron%C3%B3metro">
        <h3>Cronómetro digital</h3>
        <p class="price">$6.200</p>
        <button>Agregar al carrito</button>
      </div>
      <div class="product">
        <img src="https://via.placeholder.com/220x150?text=Botella+agua">
        <h3>Botella deportiva 600ml</h3>
        <p class="price">$3.800</p>
        <button>Agregar al carrito</button>
      </div>
    </div>
  </section>

  <footer>
    <p>&copy; 2025 Tienda de Atletismo - Todos los derechos reservados</p>
  </footer>

</body>
</html>
